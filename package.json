{
  "name": "Livraria",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0",
    "@cap-js/cds-typer": ">=0.1"
  },
  "scripts": {
